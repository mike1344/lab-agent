# ============================================================
# Docker Compose 部署参数
# 使用方法：复制本文件为同目录的 .env，按需修改。
#   Windows PowerShell:  Copy-Item .env.docker.example .env
#   Linux / macOS:       cp .env.docker.example .env
# .env 已被 git 忽略，不会提交到仓库。详细步骤见 DEPLOY.md。
# ============================================================

# ---- 访问端口 ----
# 浏览器访问端口（http://服务器IP:端口）。默认 80；被占用可改成 8080 等。
WEB_PORT=80

# ---- 数据库密码（务必修改；建议只用字母数字，避免连接串转义问题）----
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_PASSWORD=change-me-app-password

# ---- JWT 签名密钥（务必修改：泄露等于任何人都能伪造登录凭证）----
# 生成方法：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_EXPIRE_HOURS=24

# ---- 跨域来源 ----
# 前后端同源部署（默认方案）用不到；前端单独部署到其他域名时改成实际域名。
CORS_ORIGINS=http://localhost

# ---- 运行时调整（一般不用改）----
# Uvicorn 进程数；低配机器（1核1G）建议 1
WEB_CONCURRENCY=2

# ---- AI 助手（可选；不填 Key 时自动使用本地知识库，功能不受影响）----
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4.1-mini
