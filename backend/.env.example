# MySQL 数据库需要先创建，例如：CREATE DATABASE lab_agent CHARACTER SET utf8mb4;
DATABASE_URL=mysql+pymysql://root:your_password@127.0.0.1:3306/lab_agent

# 请在实际项目中换成足够长的随机字符串。
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_EXPIRE_HOURS=24
JWT_ALGORITHM=HS256
# 刷新令牌有效期（天）：access token 过期后前端用它无感续期，过期则必须重新登录
JWT_REFRESH_EXPIRE_DAYS=7

# 允许跨域的前端地址，多个用英文逗号分隔；部署时改成实际前端域名或服务器地址。
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 启动时自动创建缺失的表（开发便捷）；生产环境建议 false，表结构交给 Alembic 迁移管理。
AUTO_CREATE_TABLES=true

# 定时任务（过期预约自动关闭、开课前提醒）。多副本部署时只在一个实例上设 true，避免重复发通知。
SCHEDULER_ENABLED=true

# 登录安全：图形验证码默认开启；失败 5 次锁定 15 分钟；验证码 5 分钟有效。
# 说明：失败计数为内存实现，多 worker（WEB_CONCURRENCY>1）部署时各进程独立计数。
LOGIN_CAPTCHA_ENABLED=true
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
CAPTCHA_EXPIRE_MINUTES=5

# 邮件通知（可选）：审核结果、开课提醒、报修进度会同步发邮件。
# 不填 SMTP_HOST 时静默跳过（只发站内通知），与 AI Key 同样的降级风格。
# 示例：QQ 邮箱 smtp.qq.com / 163 邮箱 smtp.163.com（密码用授权码，不是登录密码）
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# 可观测性与限流
# 日志级别：DEBUG/INFO/WARNING/ERROR
LOG_LEVEL=INFO
RATE_LIMIT_ENABLED=true
# 每分钟上限：认证接口（登录/注册/刷新）、AI 接口、其余接口
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_AI_PER_MINUTE=30
RATE_LIMIT_PER_MINUTE=120
# Prometheus 指标开关；Sentry 不填 DSN 时自动跳过
METRICS_ENABLED=true
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.0

# 合规与上传安全
# 审计留存天数（《网络安全法》要求不少于 6 个月）；每天 03:00 清理过期日志
AUDIT_RETENTION_DAYS=180
# 危险操作二次确认（删除实验室/设备/用户/公告、驳回预约）：生产必须 true
SIGNATURE_REQUIRED=true
# 二次验证有效期（分钟）：验证通过后该窗口内重复危险操作免输；0 = 每次都要输入
SIGNATURE_TTL_MINUTES=5
# 可选病毒扫描：配置命令后每个上传文件都会执行（如 clamdscan --no-summary）
CLAMAV_COMMAND=
CLAMAV_REQUIRED=false

# AI 配置可选：不填写 Key 时，助手使用本地知识库降级模式。
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4.1-mini
# 推理模型思考开关（智谱等）：留空由模型默认；"disabled" 可关闭思考（更快，但前端不显示思考过程）
# 前端会把模型返回的 reasoning_content / reasoning 分片实时显示在「思考过程」区域
OPENAI_THINKING=
