# ============================================================
# production（生产）环境配置模板：复制为 backend/.env 使用
# 注意：所有 CHANGE_ME 必须替换；密码类值只进密钥管理，不要提交到仓库
# ============================================================
DATABASE_URL=mysql+pymysql://lab_agent:CHANGE_ME@mysql:3306/lab_agent

JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRE_HOURS=8
JWT_REFRESH_EXPIRE_DAYS=7

CORS_ORIGINS=https://lab.example.edu.cn

# 生产禁止启动时隐式建表，表结构完全交给 Alembic
AUTO_CREATE_TABLES=false
# 多进程部署时调度器只在一个专用实例开启，避免重复通知
SCHEDULER_ENABLED=false

LOGIN_CAPTCHA_ENABLED=true
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=30
CAPTCHA_EXPIRE_MINUTES=5

SMTP_HOST=smtp.example.edu.cn
SMTP_PORT=465
SMTP_USERNAME=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=lab-agent@example.edu.cn
SMTP_USE_TLS=false

LOG_LEVEL=INFO
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=5
RATE_LIMIT_AI_PER_MINUTE=20
RATE_LIMIT_PER_MINUTE=100
METRICS_ENABLED=true
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.2

OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4.1-mini
