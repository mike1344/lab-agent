# ============================================================
# staging（预发）环境配置模板：复制为 backend/.env 使用
# 目标：尽量贴近生产，但用测试账号与较低权限的数据
# ============================================================
DATABASE_URL=mysql+pymysql://lab_agent:CHANGE_ME@127.0.0.1:3306/lab_agent_staging

JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRE_HOURS=8
JWT_REFRESH_EXPIRE_DAYS=3

CORS_ORIGINS=https://staging.example.com

# 预发建议由 Alembic 管理表结构，不再启动时隐式建表
AUTO_CREATE_TABLES=false
# 多进程/多副本部署时只在一个实例开调度器
SCHEDULER_ENABLED=false

LOGIN_CAPTCHA_ENABLED=true
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
CAPTCHA_EXPIRE_MINUTES=5

# 预发也要真实发信，但走测试邮箱
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=lab-agent@example.com
SMTP_USE_TLS=true

LOG_LEVEL=INFO
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_AI_PER_MINUTE=30
RATE_LIMIT_PER_MINUTE=120
METRICS_ENABLED=true
SENTRY_DSN=
SENTRY_ENVIRONMENT=staging
SENTRY_TRACES_SAMPLE_RATE=0.1

OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4.1-mini
